NODE_ENV=development
LOG_LEVEL=info

# --- Local development (plaintext, unauthenticated Docker Compose services) ---
# Without this opt-in every service refuses plaintext/unauthenticated Redis and Kafka.
SCP_ALLOW_INSECURE_LOCAL=true
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sensors-connectivity

REDIS_URL=redis://localhost:6379

# --- Production (Cloud Run + Memorystore + Managed Service for Apache Kafka) ---
# Remove SCP_ALLOW_INSECURE_LOCAL and KAFKA_SECURITY_PROTOCOL=PLAINTEXT above, then set:
# KAFKA_BROKERS=<managed-kafka-private-bootstrap>:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=OAUTHBEARER       # or PLAIN (short-lived access token fallback)
# KAFKA_AUTH_PROVIDER=google-adc         # Cloud Run service-account identity, no JSON key
# KAFKA_TLS_CA_PATH=/var/run/secrets/kafka/ca.pem   # only for brokers outside the system trust store
# KAFKA_TLS_SERVERNAME=                  # optional SNI/verification host override
# KAFKA_GOOGLE_PRINCIPAL=                # optional service-account e-mail override
# REDIS_URL=rediss://<private-redis-host>:6378
# REDIS_AUTH_PASSWORD=<injected from Secret Manager; never commit>
# REDIS_TLS_CA_PATH=/var/run/secrets/redis/ca.pem   # Memorystore instance CA (may hold several PEM certs)
# REDIS_TLS_SERVERNAME=                  # optional TLS server name override
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=2000
SUBSTRATE_WS_URL=ws://localhost:9944

ENDPOINT_PORT=3000
ENDPOINT_SOURCE=endpoint
ENDPOINT_TIMESTAMP_SKEW_SECONDS=300
# Shared Redis replay protection. TTL must be >= 2 x ENDPOINT_TIMESTAMP_SKEW_SECONDS + 60.
NONCE_REDIS_PREFIX=nonce:v1
NONCE_TTL_SECONDS=900
ENDPOINT_PRODUCER_MAX_ATTEMPTS=3
ENDPOINT_PRODUCER_RETRY_BACKOFF_MS=100
# Sensor authentication strategy: whitelist (default), none (accept any validly-signed sensor) or cps (CPS subtree of sensors.social)
SENSOR_AUTH_STRATEGY=whitelist
# Whitelist configuration (only used when SENSOR_AUTH_STRATEGY=whitelist)
# WHITELIST_SENSOR_IDS=sensor-1,sensor-2,sensor-3
# CPS subtree authentication (only used when SENSOR_AUTH_STRATEGY=cps)
# CPS_ROOT_ADDRESS=<sensors.social-root-address>
# CPS_AUTH_CACHE_MAX_SIZE=100000
# CPS_AUTH_NEGATIVE_TTL_SECONDS=60
PUBSUB_TOPIC=telemetry/authorized/v1
PUBSUB_BROADCASTER_GROUP_ID=pubsub-broadcaster-v1
PUBSUB_BROADCASTER_SOURCE=pubsub-broadcaster
PUBSUB_BROADCASTER_HEALTH_PORT=3020
PUBSUB_BROADCASTER_MAX_RETRIES=3
PUBSUB_BROADCASTER_RETRY_BACKOFF_MS=250
# Heartbeat tracker (trusted telemetry liveness + uptime observability)
HEARTBEAT_TRACKER_GROUP_ID=heartbeat-tracker-v1
HEARTBEAT_TRACKER_SOURCE=heartbeat-tracker
HEARTBEAT_TRACKER_HEALTH_PORT=3030
HEARTBEAT_TRACKER_ONLINE_WINDOW_MS=30000
HEARTBEAT_TRACKER_REDIS_PREFIX=heartbeat-tracker:v1
# Batcher (batches, zstd-compresses, and size-fits authorized telemetry into telemetry.batched.v1)
BATCHER_GROUP_ID=batcher-v1
BATCHER_SOURCE=batcher
BATCHER_HEALTH_PORT=3041
BATCHER_BATCH_SIZE=10
BATCHER_BATCH_TIMEOUT_MS=30000
# Shared max compressed payload size for a single anchored batch (bytes)
ANCHOR_MAX_PAYLOAD_BYTES=8192
# Blockchain anchor (anchors compressed telemetry batches to Robonomics CPS pallet)
BLOCKCHAIN_ANCHOR_GROUP_ID=blockchain-anchor-v1
BLOCKCHAIN_ANCHOR_NODE_ID=0
BLOCKCHAIN_ANCHOR_SURI=//Alice
BLOCKCHAIN_ANCHOR_HEALTH_PORT=3050
BLOCKCHAIN_ANCHOR_SOURCE=blockchain-anchor
BLOCKCHAIN_TARGET=robonomics-dev
